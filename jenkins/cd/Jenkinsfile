pipeline {
    agent any

    environment {
        AWS_ACCESS_KEY_ID     = credentials('aws-access-key-id')
        AWS_SECRET_ACCESS_KEY = credentials('aws-secret-access-key')
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        KEY_PATH              = '~/Desktop/oz-seyoawe-key.pem'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Terraform Init') {
            steps {
                dir('terraform') {
                    sh 'terraform init'
                }
            }
        }

        stage('Terraform Plan') {
            steps {
                dir('terraform') {
                    sh 'terraform plan'
                }
            }
        }

        stage('Terraform Apply') {
            steps {
                dir('terraform') {
                    sh 'terraform apply -auto-approve'
                    script {
                        env.ENGINE_IP = sh(
                            script: 'terraform output -raw instance_public_ip',
                            returnStdout: true
                        ).trim()
                        echo "EC2 instance IP: ${env.ENGINE_IP}"
                    }
                }
            }
        }

        stage('Update Ansible Inventory') {
            steps {
                sh """
                    sed -i 's/WILL_BE_FILLED_BY_TERRAFORM/${env.ENGINE_IP}/' ansible/inventory.ini
                """
            }
        }

        stage('Wait for EC2') {
            steps {
                sh 'sleep 30'
            }
        }

        stage('Run Ansible Playbook') {
            steps {
                sh """
                    ansible-playbook -i ansible/inventory.ini \
                        --private-key ${KEY_PATH} \
                        ansible/playbook.yml
                """
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                sh 'kubectl apply -f k8s/engine-pvc.yaml'
                sh 'kubectl apply -f k8s/engine-service.yaml'
                sh 'kubectl apply -f k8s/engine-statefulset.yaml'
            }
        }

    }

    post {
        success {
            echo "CD Pipeline completed! Engine deployed at ${env.ENGINE_IP}:8080" 
        }
        failure {
            echo "CD Pipeline failed!"
        }
    }
}