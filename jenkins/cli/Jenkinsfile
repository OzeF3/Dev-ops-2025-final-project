pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKERHUB_REPO = 'devoeoe23ops/seyoawe-cli'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Version Check') {
            steps {
                script {
                    def version = readFile('version.txt').trim()
                    env.IMAGE_TAG = version
                    echo "Building CLI version: ${version}"
                }
            }
        }

        stage('Install Dependencies') {
            steps {
                bat 'pip install -r sawectl/requirements.txt'
            }
        }

        stage('Lint') {
            steps {
                bat 'pip install flake8'
                bat 'flake8 sawectl/sawectl.py --max-line-length=120 --ignore=E501,W503,W504,E402,F401,E302,F541,F841,W293,W291,E303,W292'
            }
        }

        stage('Unit Tests') {
            steps {
                bat 'pytest sawectl/ --verbose'
            }
        }

        stage('Build Linux Binary') {
            steps {
                bat 'pip install pyinstaller'
                bat 'pyinstaller --onefile --name sawectl --distpath sawectl/binaries/linux sawectl/sawectl.py'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat "docker build -t %DOCKERHUB_REPO%:%IMAGE_TAG% -t %DOCKERHUB_REPO%:latest -f docker/cli/Dockerfile ."
            }
        }

        stage('Push to Docker Hub') {
            steps {
                bat "echo %DOCKERHUB_CREDENTIALS_PSW% | docker login -u %DOCKERHUB_CREDENTIALS_USR% --password-stdin"
                bat "docker push %DOCKERHUB_REPO%:%IMAGE_TAG%"
                bat "docker push %DOCKERHUB_REPO%:latest"
            }
        }

        stage('Tag Git Version') {
            steps {
                withCredentials([usernamePassword(credentialsId: 'github-credentials', usernameVariable: 'GIT_USER', passwordVariable: 'GIT_TOKEN')]) {
                    bat "git config user.email \"jenkins@ci.com\""
                    bat "git config user.name \"Jenkins\""
                    bat "git remote set-url origin https://%GIT_USER%:%GIT_TOKEN%@github.com/OzeF3/Dev-ops-2025-final-project.git"
                    bat "git tag -d v%IMAGE_TAG% || echo Tag does not exist locally"
                    bat "git push origin :refs/tags/v%IMAGE_TAG% || echo Tag does not exist remotely"
                    bat "git tag -a v%IMAGE_TAG% -m \"CLI release v%IMAGE_TAG%\""
                    bat "git push origin v%IMAGE_TAG%"
                }
            }
        }
    }

    post {
        always {
            bat 'docker logout'
        }
        success {
            echo "CLI image pushed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}
