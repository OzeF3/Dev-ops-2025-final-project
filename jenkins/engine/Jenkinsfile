// ============================================================================
// Engine CI Pipeline
//
// Version coupling:
//   - Reads semver from version.txt (shared with CLI -> same tag everywhere)
//   - Detects whether engine-relevant files changed vs the previous commit
//   - Skips Build + Push stages when nothing engine-related changed
// ============================================================================

pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKERHUB_REPO        = 'devoeoe23ops/seyoawe-engine'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Version Check') {
            steps {
                script {
                    // --- Shared semver (couples engine <-> CLI) ---
                    def version = readFile('version.txt').trim()
                    env.IMAGE_TAG = version
                    echo "Shared version from version.txt: ${version}"

                    // --- Change detection (engine-relevant paths only) ---
                    def changed = bat(
                        script: '@git diff --name-only HEAD~1 HEAD',
                        returnStdout: true
                    ).trim()
                    echo "Changed files since last commit:\n${changed}"

                    def engineChanged = changed.split('\r?\n').any { line ->
                        line.startsWith('modules/') ||
                        line.startsWith('configuration/') ||
                        line.startsWith('workflows/') ||
                        line.startsWith('docker/engine/') ||
                        line == 'seyoawe.linux' ||
                        line == 'run.sh' ||
                        line == 'version.txt'
                    }

                    env.ENGINE_CHANGED = engineChanged.toString()
                    echo "ENGINE_CHANGED = ${env.ENGINE_CHANGED}"

                    if (!engineChanged) {
                        echo "No engine-relevant changes detected. Build + Push will be skipped."
                    }
                }
            }
        }

        stage('Lint') {
            steps {
                bat 'pip install flake8'
                bat 'flake8 modules/ configuration/ --max-line-length=120 --ignore=E501,W503,W504,E402,F401,E302,F541,F841,W293,W291,E303,W292 || exit 0'
            }
        }

        stage('Build Docker Image') {
            when { expression { env.ENGINE_CHANGED == 'true' } }
            steps {
                bat "docker build -t %DOCKERHUB_REPO%:%IMAGE_TAG% -t %DOCKERHUB_REPO%:latest -f docker/engine/Dockerfile ."
            }
        }

        stage('Push to Docker Hub') {
            when { expression { env.ENGINE_CHANGED == 'true' } }
            steps {
                bat "echo %DOCKERHUB_CREDENTIALS_PSW% | docker login -u %DOCKERHUB_CREDENTIALS_USR% --password-stdin"
                bat "docker push %DOCKERHUB_REPO%:%IMAGE_TAG%"
                bat "docker push %DOCKERHUB_REPO%:latest"
            }
        }

        stage('Skip Notice') {
            when { expression { env.ENGINE_CHANGED != 'true' } }
            steps {
                echo "Skipping Build + Push: no engine-relevant changes in this commit."
            }
        }
    }

    post {
        always {
            bat 'docker logout'
        }
        success {
            echo "Engine CI completed successfully (version ${env.IMAGE_TAG}, changed=${env.ENGINE_CHANGED})"
        }
        failure {
            withCredentials([
                string(credentialsId: 'jira-api-token', variable: 'JIRA_TOKEN'),
                string(credentialsId: 'jira-email', variable: 'JIRA_EMAIL'),
                string(credentialsId: 'jira-project-key', variable: 'JIRA_PROJECT')
            ]) {
                bat """
                    curl -s -X POST https://oefraty.atlassian.net/rest/api/3/issue ^
                    -H "Content-Type: application/json" ^
                    -u %JIRA_EMAIL%:%JIRA_TOKEN% ^
                    -d "{\\"fields\\": {\\"project\\": {\\"key\\": \\"%JIRA_PROJECT%\\"}, \\"summary\\": \\"CI Pipeline Failed - Build #%BUILD_NUMBER%\\", \\"description\\": {\\"type\\": \\"doc\\", \\"version\\": 1, \\"content\\": [{\\"type\\": \\"paragraph\\", \\"content\\": [{\\"type\\": \\"text\\", \\"text\\": \\"Engine CI pipeline failed on build #%BUILD_NUMBER%. Check Jenkins: %BUILD_URL%\\"}]}]}, \\"issuetype\\": {\\"name\\": \\"Bug\\"}}}"
                """
            }
            echo "Pipeline failed! Jira issue created."
        }
    }
}