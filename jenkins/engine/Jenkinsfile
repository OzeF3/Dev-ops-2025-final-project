pipeline {
    agent any

    environment {
        DOCKERHUB_CREDENTIALS = credentials('dockerhub-credentials')
        DOCKERHUB_REPO = 'devoeoe23ops/seyoawe-engine'
    }

    stages {

        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Version Check') {
            steps {
                script {
                    def version = readFile('version.txt').trim()
                    env.IMAGE_TAG = version
                    echo "Building version: ${version}"
                }
            }
        }

        stage('Lint') {
            steps {
                bat 'pip install flake8'
                bat 'flake8 sawectl/sawectl.py --max-line-length=120 --ignore=E501,W503,W504,E402,F401,E302,F541,F841,W293,W291,E303,W292'
            }
        }

        stage('Build Docker Image') {
            steps {
                bat "docker build -t %DOCKERHUB_REPO%:%IMAGE_TAG% -t %DOCKERHUB_REPO%:latest -f docker/engine/Dockerfile ."
            }
        }

        stage('Push to Docker Hub') {
            steps {
                bat "echo %DOCKERHUB_CREDENTIALS_PSW% | docker login -u %DOCKERHUB_CREDENTIALS_USR% --password-stdin"
                bat "docker push %DOCKERHUB_REPO%:%IMAGE_TAG%"
                bat "docker push %DOCKERHUB_REPO%:latest"
            }
        }
    }

    post {
        always {
            bat 'docker logout'
        }
        success {
            echo "Engine image pushed successfully!"
        }
        failure {
            echo "Pipeline failed!"
        }
    }
}