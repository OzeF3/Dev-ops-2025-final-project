# ============================================================================
# SeyoAWE Release App - Environment Configuration
#
# Copy this file to .env and fill in your own credentials.
# NEVER commit .env to source control.
# ============================================================================

# --- Gmail (for /send-email) ---
# Use a Gmail App Password, NOT your regular password.
# https://myaccount.google.com/apppasswords
GMAIL_USER=you@gmail.com
GMAIL_PASSWORD=your-16-char-app-password

# --- Jira (for /create-jira) ---
# Create an API token at https://id.atlassian.com/manage-profile/security/api-tokens
JIRA_BASE_URL=https://your-domain.atlassian.net
JIRA_EMAIL=you@company.com
JIRA_TOKEN=your-jira-api-token
JIRA_PROJECT=ABC

# --- GitHub (for /save-to-git) ---
# Create a fine-grained PAT with contents:write permission
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_your_github_token
GITHUB_REPO=owner/repository
